DO $$
DECLARE
    medicine_cursor CURSOR FOR
        SELECT medicine_name, stock_quantity
        FROM medicines
        WHERE stock_quantity <= 5;
    r RECORD;
BEGIN
    OPEN medicine_cursor;
    LOOP
        FETCH medicine_cursor INTO r;
        EXIT WHEN NOT FOUND;
        RAISE NOTICE 'Low stock: % - % remaining', r.medicine_name, r.stock_quantity;
    END LOOP;
    CLOSE medicine_cursor;
END $$;

